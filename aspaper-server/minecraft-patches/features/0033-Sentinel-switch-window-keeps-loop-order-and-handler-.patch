From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: renaud <rlpirou@gmail.com>
Date: Sat, 14 Nov 2026 04:47:31 +0100
Subject: [PATCH] Sentinel: switch window keeps loop order and handler names,
 disconnect never parks

setReadOnly and enableAutoRead now run in the loop's order: off the loop they
queue behind a protocol switch already queued, as when the caller waited for
it. A kick inside the switch window (PlayerJoinEvent,
PlayerConnectionInitialConfigureEvent) is no longer undone by the decoder
swap turning reading back on, and enableAutoRead no longer resumes reading
before the new decoder is in.

The placeholder left by a terminal packet keeps the "decoder" or "encoder"
name and position, so a plugin resolving them while the switch is queued
does not fail. The terminal packet still leaves through the old context's
neighbours.

Connection#disconnect no longer waits for the close off the loop: the reason
is set first (handleDisconnection reads it, the first disconnect wins) and
the listener stops being ticked while the channel closes.

diff --git a/net/minecraft/network/Connection.java b/net/minecraft/network/Connection.java
index 93eea2618597ccb2534f53a2b4217135f8cb8895..fca6620dfe723378ce0b0af55872bdeca20c3b07 100644
--- a/net/minecraft/network/Connection.java
+++ b/net/minecraft/network/Connection.java
@@ -74,7 +74,7 @@ public class Connection extends SimpleChannelInboundHandler<Packet<?>> {
     // Spigot end
     private volatile @Nullable PacketListener disconnectListener;
     private volatile @Nullable PacketListener packetListener;
-    private @Nullable DisconnectionDetails disconnectionDetails;
+    private final java.util.concurrent.atomic.AtomicReference<@Nullable DisconnectionDetails> disconnectionDetails = new java.util.concurrent.atomic.AtomicReference<>(); // BTCCore - Sentinel: set off the loop before the close is queued, the first one wins atomically
     private boolean disconnectionHandled;
     private int receivedPackets;
     private int sentPackets;
@@ -85,7 +85,7 @@ public class Connection extends SimpleChannelInboundHandler<Packet<?>> {
     private volatile @Nullable DisconnectionDetails delayedDisconnect;
     private @Nullable BandwidthDebugMonitor bandwidthDebugMonitor;
     public String hostname = ""; // CraftBukkit - add field
-    public boolean handleConnectionDisconnectOnNextTick = false; // Paper - Force kill connection ticking
+    public volatile boolean handleConnectionDisconnectOnNextTick = false; // Paper - Force kill connection ticking // BTCCore - Sentinel: volatile, set by an authenticator thread's refusal and read by the server thread
     // Paper start - NetworkClient implementation
     public int protocolVersion;
     public java.net.InetSocketAddress virtualHost;
@@ -682,8 +682,14 @@ public class Connection extends SimpleChannelInboundHandler<Packet<?>> {
         }
 
         if (this.isConnected()) {
-            this.channel.close().awaitUninterruptibly();
-            this.disconnectionDetails = details;
+            // BTCCore start - Sentinel: a disconnect never parks the calling thread on the Netty loop
+            // Off the loop the close is queued, not awaited: a wave of refusals (whitelist, ban, full) froze the server
+            // thread. The reason is kept first (handleDisconnection reads it once the channel is closed, the first
+            // disconnect wins as when the close was awaited) and the listener is no longer ticked while closing.
+            this.disconnectionDetails.compareAndSet(null, details);
+            this.handleConnectionDisconnectOnNextTick = true;
+            this.channel.close();
+            // BTCCore end - Sentinel: a disconnect never parks the calling thread on the Netty loop
         }
     }
 
@@ -834,19 +840,19 @@ public class Connection extends SimpleChannelInboundHandler<Packet<?>> {
     }
 
     public @Nullable DisconnectionDetails getDisconnectionDetails() {
-        return this.disconnectionDetails;
+        return this.disconnectionDetails.get(); // BTCCore - Sentinel: first disconnect wins atomically
     }
 
     public void setReadOnly() {
         if (this.channel != null) {
-            this.channel.config().setAutoRead(false);
+            dev.btc.core.security.exploit.ProtocolSwitches.setAutoRead(this.channel, false); // BTCCore - Sentinel: in loop order, behind a queued protocol switch
         }
     }
 
     // Paper start - add proper async disconnect
     public void enableAutoRead() {
         if (this.channel != null) {
-            this.channel.config().setAutoRead(true);
+            dev.btc.core.security.exploit.ProtocolSwitches.setAutoRead(this.channel, true); // BTCCore - Sentinel: in loop order, behind a queued protocol switch
         }
     }
     // Paper end - add proper async disconnect
diff --git a/net/minecraft/network/ProtocolSwapHandler.java b/net/minecraft/network/ProtocolSwapHandler.java
index d162238f5824c7038c5c97d52dcb7d123a4792c1..3d924dbb99fbd30d1f13d257d9a661a794ba66d4 100644
--- a/net/minecraft/network/ProtocolSwapHandler.java
+++ b/net/minecraft/network/ProtocolSwapHandler.java
@@ -7,15 +7,13 @@ public interface ProtocolSwapHandler {
     static void handleInboundTerminalPacket(final ChannelHandlerContext ctx, final Packet<?> packet) {
         if (packet.isTerminal()) {
             ctx.channel().config().setAutoRead(false);
-            ctx.pipeline().addBefore(ctx.name(), HandlerNames.INBOUND_CONFIG, new UnconfiguredPipelineHandler.Inbound());
-            ctx.pipeline().remove(ctx.name());
+            dev.btc.core.security.exploit.ProtocolSwitches.parkKeepingName(ctx, HandlerNames.DECODER, HandlerNames.INBOUND_CONFIG, new UnconfiguredPipelineHandler.Inbound()); // BTCCore - Sentinel: "decoder" stays resolvable while the switch is queued
         }
     }
 
     static void handleOutboundTerminalPacket(final ChannelHandlerContext ctx, final Packet<?> packet) {
         if (packet.isTerminal()) {
-            ctx.pipeline().addAfter(ctx.name(), HandlerNames.OUTBOUND_CONFIG, new UnconfiguredPipelineHandler.Outbound());
-            ctx.pipeline().remove(ctx.name());
+            dev.btc.core.security.exploit.ProtocolSwitches.parkKeepingName(ctx, HandlerNames.ENCODER, HandlerNames.OUTBOUND_CONFIG, new UnconfiguredPipelineHandler.Outbound()); // BTCCore - Sentinel: "encoder" stays resolvable while the switch is queued
         }
     }
 }
diff --git a/net/minecraft/server/network/ServerLoginPacketListenerImpl.java b/net/minecraft/server/network/ServerLoginPacketListenerImpl.java
index a1855a257c3ac801bbd371ca4508af755550d737..7a8a533f184afd069aaeec7e8948a9d3affadef8 100644
--- a/net/minecraft/server/network/ServerLoginPacketListenerImpl.java
+++ b/net/minecraft/server/network/ServerLoginPacketListenerImpl.java
@@ -205,6 +205,13 @@ public class ServerLoginPacketListenerImpl implements ServerLoginPacketListener,
     }
 
     private void startClientVerification(final GameProfile profile) {
+        // BTCCore start - Sentinel: a refused login (AsyncPlayerPreLogin) is never verified
+        // The disconnect no longer waits for the channel to close: a refused player would otherwise go on to
+        // PlayerLoginEvent and kick an online player with the same profile before its close lands.
+        if (this.connection.handleConnectionDisconnectOnNextTick) {
+            return;
+        }
+        // BTCCore end - Sentinel: a refused login (AsyncPlayerPreLogin) is never verified
         this.authenticatedProfile = profile;
         this.state = ServerLoginPacketListenerImpl.State.VERIFYING;
     }
