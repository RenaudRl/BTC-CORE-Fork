diff --git a/net/minecraft/server/network/ServerCommonPacketListenerImpl.java b/net/minecraft/server/network/ServerCommonPacketListenerImpl.java
index 68ba2591350ed1cf264f219f133963ae7c9b9244..3f75bb2dd4c1d6c3264f05ac585fca475211cfac 100644
--- a/net/minecraft/server/network/ServerCommonPacketListenerImpl.java
+++ b/net/minecraft/server/network/ServerCommonPacketListenerImpl.java
@@ -319,6 +319,16 @@ public abstract class ServerCommonPacketListenerImpl implements ServerCommonPack
     }
 
     public void send(final Packet<?> packet, final @Nullable ChannelFutureListener listener) {
+        // BTC-CORE start - player block overlay: this player gets its covered cells instead (shared packets stay untouched)
+        final dev.btc.core.overlay.PlayerBlockOverlayImpl btcOverlay = this instanceof ServerGamePacketListenerImpl game ? game.player.btcBlockOverlay : null;
+        if (btcOverlay != null) {
+            final Packet<?> seen = btcOverlay.rewrite(packet);
+            if (seen != packet) {
+                this.send(seen, listener);
+                return;
+            }
+        }
+        // BTC-CORE end
         // CraftBukkit start
         if (packet == null) {
             return;
@@ -340,6 +350,7 @@ public abstract class ServerCommonPacketListenerImpl implements ServerCommonPack
             category.setDetail("Packet class", () -> packet.getClass().getCanonicalName());
             throw new ReportedException(report);
         }
+        if (btcOverlay != null) btcOverlay.afterSend(packet); // BTC-CORE - player block overlay: covered sections follow their chunk on the same connection
     }
 
     @Deprecated // Paper - kick event causes TODO check on update: ensure all call to this are from the configuration phase
