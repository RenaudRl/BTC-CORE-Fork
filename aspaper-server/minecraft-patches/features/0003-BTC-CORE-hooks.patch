         public LootTable getLootTable(final ResourceKey<LootTable> id) {
+            // BTCCore start - vanilla-content.purge-loot
+            // En 26.3 les tables de butin sont chargees par RegistryDataLoader et arrivent dans un
+            // registre DEJA GELE : on ne peut plus retirer les entrees a la lecture, comme le faisait
+            // scheduleRegistryLoad en 26.2. La table purgee reste donc declaree - ce qui evite les
+            // avertissements de reference manquante - mais ne rend plus rien, ce qui est l'effet voulu.
+            if (dev.btc.core.config.BTCCoreConfig.shouldDropLootTable(id.identifier().getNamespace(), id.identifier().getPath())) {
+                return LootTable.EMPTY;
+            }
+            // BTCCore end
             return this.registries.lookup(Registries.LOOT_TABLE).flatMap(r -> r.get(id)).map(net.minecraft.core.Holder::value).orElse(LootTable.EMPTY);
         }
     }
