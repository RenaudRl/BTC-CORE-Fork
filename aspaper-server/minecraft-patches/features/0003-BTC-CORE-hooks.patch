diff --git a/net/minecraft/server/network/ServerCommonPacketListenerImpl.java b/net/minecraft/server/network/ServerCommonPacketListenerImpl.java
index 5dbb2849f32ac3418f8fdf76c04022d7e9dc165b..68ba2591350ed1cf264f219f133963ae7c9b9244 100644
--- a/net/minecraft/server/network/ServerCommonPacketListenerImpl.java
+++ b/net/minecraft/server/network/ServerCommonPacketListenerImpl.java
@@ -301,6 +301,20 @@ public abstract class ServerCommonPacketListenerImpl implements ServerCommonPack
     }
 
     public void send(final Packet<?> packet) {
+        // BTCCore start - batched inventory updates
+        if (dev.btc.core.config.BTCCoreConfig.batchedInventoryUpdates
+            && this instanceof ServerGamePacketListenerImpl gameListener) {
+            if (packet instanceof net.minecraft.network.protocol.game.ClientboundContainerSetSlotPacket slotPacket
+                && dev.btc.core.performance.BatchedInventoryUpdates.queue(gameListener.player, slotPacket)) {
+                return;
+            }
+            // Drain before anything the client applies to the same container state, so a coalesced
+            // slot update can never overtake a screen change or a full content resend.
+            if (dev.btc.core.performance.BatchedInventoryUpdates.isOrderSensitive(packet)) {
+                dev.btc.core.performance.BatchedInventoryUpdates.flush(gameListener.player);
+            }
+        }
+        // BTCCore end
         this.send(packet, null);
     }
 
