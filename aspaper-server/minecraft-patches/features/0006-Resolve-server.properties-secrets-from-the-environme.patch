From: BTC Core <core@borntocraftstudio.net>
Date: Tue, 15 Sep 2026 05:17:37 +0200
Subject: [PATCH] Resolve server.properties secrets from the environment


diff --git a/net/minecraft/server/dedicated/Settings.java b/net/minecraft/server/dedicated/Settings.java
index 178f750c114afe26c98ff3434e6837f0b5f40f65..fa200c043342f7d55098e859363c017069c037a8 100644
--- a/net/minecraft/server/dedicated/Settings.java
+++ b/net/minecraft/server/dedicated/Settings.java
@@ -27,6 +27,16 @@ public abstract class Settings<T extends Settings<T>> {
     private static final Logger LOGGER = LogUtils.getLogger();
     public final Properties properties;
     private static final boolean skipComments = Boolean.getBoolean("Paper.skipServerPropertiesComments"); // Paper - allow skipping server.properties comments
+    // BTC start - resoudre les secrets par variables d'environnement
+    // Une propriete dont la valeur entiere vaut ${env:NOM} est lue dans l'environnement du processus.
+    // Cela permet a un orchestrateur (CloudNet) de livrer rcon.password ou management-server-secret
+    // sans que le secret figure jamais dans un modele de serveur.
+    private static final java.util.regex.Pattern ENVIRONMENT_PLACEHOLDER = java.util.regex.Pattern.compile("\\$\\{env:([A-Za-z_][A-Za-z0-9_]*)}");
+    // Invariant : this.properties ne contient JAMAIS une valeur resolue, seulement le renvoi d'origine.
+    // C'est ce qui garantit que store() ne recrit pas un secret sur le disque et que reload() le propage
+    // sous sa forme non resolue.
+    private final java.util.Map<String, String> environmentPlaceholders = new java.util.concurrent.ConcurrentHashMap<>();
+    // BTC end - resoudre les secrets par variables d'environnement
     // CraftBukkit start
     private joptsimple.OptionSet options = null;
 
@@ -147,9 +157,43 @@ public abstract class Settings<T extends Settings<T>> {
     }
 
     public @Nullable String getStringRaw(final String key) {
-        return (String)this.getOverride(key, this.properties.getProperty(key)); // CraftBukkit
+        return this.resolveEnvironmentPlaceholder(key, (String)this.getOverride(key, this.properties.getProperty(key))); // CraftBukkit // BTC - resoudre les secrets par variables d'environnement
     }
 
+    // BTC start - resoudre les secrets par variables d'environnement
+    private @Nullable String resolveEnvironmentPlaceholder(final String key, final @Nullable String value) {
+        if (value == null) {
+            return null;
+        }
+
+        final java.util.regex.Matcher matcher = ENVIRONMENT_PLACEHOLDER.matcher(value);
+        if (!matcher.matches()) {
+            return value;
+        }
+
+        // Memorise avant tout retour : le renvoi doit survivre a store() meme quand il n'est pas resoluble.
+        this.environmentPlaceholders.put(key, value);
+
+        final String variable = matcher.group(1);
+        final String resolved = System.getenv(variable);
+        if (resolved == null || resolved.isEmpty()) {
+            // Jamais de repli silencieux : un mot de passe absent doit desactiver le service, pas valoir
+            // la chaine "${env:...}". On rend la propriete absente, donc sa valeur par defaut s'applique.
+            LOGGER.error("Property '{}' reads environment variable '{}', which is not set. Treating the property as absent.", key, variable);
+            return null;
+        }
+
+        return resolved;
+    }
+
+    // Ecrit dans this.properties la forme destinee au disque : le renvoi d'origine s'il y en avait un,
+    // sinon la valeur serialisee.
+    private void putUnresolved(final String key, final String serialized) {
+        final String placeholder = this.environmentPlaceholders.get(key);
+        this.properties.put(key, placeholder != null ? placeholder : serialized);
+    }
+    // BTC end - resoudre les secrets par variables d'environnement
+
     protected <V> @Nullable V getLegacy(final String key, final Function<String, V> deserializer) {
         String value = this.getStringRaw(key);
         if (value == null) {
@@ -173,7 +217,7 @@ public abstract class Settings<T extends Settings<T>> {
         // CraftBukkit end
         String value = this.getStringRaw(key);
         V result = MoreObjects.firstNonNull(value != null ? deserializer.apply(value) : null, defaultValue);
-        this.properties.put(key, serializer.apply(result));
+        this.putUnresolved(key, serializer.apply(result)); // BTC - resoudre les secrets par variables d'environnement
         return result;
     }
 
@@ -182,7 +226,7 @@ public abstract class Settings<T extends Settings<T>> {
     ) {
         String value = this.getStringRaw(key);
         V result = MoreObjects.firstNonNull(value != null ? deserializer.apply(value) : null, defaultValue);
-        this.properties.put(key, serializer.apply(result));
+        this.putUnresolved(key, serializer.apply(result)); // BTC - resoudre les secrets par variables d'environnement
         return new Settings<T>.MutableValue<>(key, result, serializer);
     }
 
