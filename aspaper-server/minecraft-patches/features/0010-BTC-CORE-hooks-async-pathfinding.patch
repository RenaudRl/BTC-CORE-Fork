@@ -115,6 +137,58 @@ public class MoveToTargetSink extends Behavior<Mob> {
         }
     }
 
+    // BTCCore start - async.async-pathfinding - the vanilla flow split around the search (Kaiiju/Petal)
+    private void tickAsync(final ServerLevel level, final Mob body, final long timestamp) {
+        if (this.path != null && !this.path.isProcessed()) return; // still searched
+
+        Brain<?> brain = body.getBrain();
+        if (!this.finishedProcessing) {
+            this.finishedProcessing = true;
+
+            boolean canReach = this.path != null && this.path.canReach();
+            if (canReach) {
+                brain.eraseMemory(MemoryModuleType.CANT_REACH_WALK_TARGET_SINCE);
+            } else if (!brain.hasMemoryValue(MemoryModuleType.CANT_REACH_WALK_TARGET_SINCE)) {
+                brain.setMemory(MemoryModuleType.CANT_REACH_WALK_TARGET_SINCE, timestamp);
+            }
+
+            if (!canReach) {
+                Optional<WalkTarget> walkTarget = brain.getMemory(MemoryModuleType.WALK_TARGET);
+                if (walkTarget.isEmpty()) return;
+
+                BlockPos targetPos = walkTarget.get().getTarget().currentBlockPosition();
+                Vec3 partialStep = DefaultRandomPos.getPosTowards((PathfinderMob)body, 10, 7, Vec3.atBottomCenterOf(targetPos), (float) (Math.PI / 2));
+                if (partialStep != null) {
+                    // search again toward a random position on the way
+                    this.path = body.getNavigation().createPath(partialStep.x, partialStep.y, partialStep.z, 0);
+                    this.finishedProcessing = false;
+                    return;
+                }
+            }
+
+            brain.setMemory(MemoryModuleType.PATH, this.path);
+            body.getNavigation().moveTo(this.path, this.speedModifier);
+        }
+
+        Path currentPath = body.getNavigation().getPath();
+        if (currentPath != null && this.lastTargetPos != null && brain.hasMemoryValue(MemoryModuleType.WALK_TARGET)) {
+            WalkTarget walkTarget = brain.getMemory(MemoryModuleType.WALK_TARGET).get();
+            if (walkTarget.getTarget().currentBlockPosition().distSqr(this.lastTargetPos) > 4.0) {
+                this.start(level, body, timestamp);
+            }
+        }
+    }
+
+    private @Nullable Path computePath(final Mob body, final WalkTarget walkTarget) {
+        BlockPos targetPos = walkTarget.getTarget().currentBlockPosition();
+        this.speedModifier = walkTarget.getSpeedModifier();
+        if (this.reachedTarget(body, walkTarget)) {
+            body.getBrain().eraseMemory(MemoryModuleType.CANT_REACH_WALK_TARGET_SINCE);
+        }
+        return body.getNavigation().createPath(targetPos, 0);
+    }
+    // BTCCore end - async.async-pathfinding
+
     private boolean tryComputePath(final Mob body, final WalkTarget walkTarget, final long timestamp) {
         BlockPos targetPos = walkTarget.getTarget().currentBlockPosition();
         this.path = body.getNavigation().createPath(targetPos, 0);
