From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: BTC Core <core@borntocraftstudio.net>
Date: Mon, 17 Aug 2026 05:15:00 +0200
Subject: [PATCH] Batch recipe finalization

RecipeManager rebuilt all derived recipe displays and property sets after
each Bukkit recipe mutation. Bulk RPG Core registration therefore spent
seconds finalizing the same 1,500 recipes repeatedly. Keep the existing
single-recipe behavior, but provide an explicit batch boundary for the
Bukkit server adapter.

diff --git a/net/minecraft/world/item/crafting/RecipeManager.java b/net/minecraft/world/item/crafting/RecipeManager.java
index e403e3edd159fc39287bdd49bd8895a8ea554e77..9d6184dde7a12dfe6c24b9b683366c93daa85bd4 100644
--- a/net/minecraft/world/item/crafting/RecipeManager.java
+++ b/net/minecraft/world/item/crafting/RecipeManager.java
@@ -53,6 +53,8 @@ public class RecipeManager implements RecipeAccess {
     private Map<ResourceKey<Recipe<?>>, List<RecipeManager.ServerDisplayInfo>> recipeToDisplay = Map.of();
     private final Collection<RecipeHolder<?>> learnableRecipes;
 
+    private boolean recipeBatchActive;
+
     public RecipeManager(final HolderLookup.Provider registries) {
         HolderLookup.RegistryLookup<Recipe<?>> recipeRegistries = registries.lookupOrThrow(Registries.RECIPE);
         this.recipes = RecipeMap.create(recipeRegistries);
@@ -73,11 +75,20 @@ public class RecipeManager implements RecipeAccess {
     public void addRecipe(RecipeHolder<?> holder) {
         org.spigotmc.AsyncCatcher.catchOp("Recipe Add"); // Spigot
         this.recipes.addRecipe(holder);
-        this.finalizeRecipeLoading();
+        if (!this.recipeBatchActive) {
+            this.finalizeRecipeLoading();
+        }
     }
 
     private FeatureFlagSet enabledFlags;
 
+    public void beginRecipeBatch() { this.recipeBatchActive = true; }
+    public void endRecipeBatch() {
+        if (!this.recipeBatchActive) return;
+        this.recipeBatchActive = false;
+        if (this.enabledFlags != null) this.finalizeRecipeLoading(this.enabledFlags);
+    }
+
     public void finalizeRecipeLoading() {
         if (this.enabledFlags != null) {
             this.finalizeRecipeLoading(this.enabledFlags);
@@ -202,7 +213,9 @@ public class RecipeManager implements RecipeAccess {
     public boolean removeRecipe(ResourceKey<Recipe<?>> id) {
         boolean removed = this.recipes.removeRecipe(id);
         if (removed) {
-            this.finalizeRecipeLoading();
+            if (!this.recipeBatchActive) {
+                this.finalizeRecipeLoading();
+            }
         }
 
         return removed;
@@ -210,7 +223,9 @@ public class RecipeManager implements RecipeAccess {
 
     public void clearRecipes() {
         this.recipes = RecipeMap.createEmpty();
-        this.finalizeRecipeLoading();
+        if (!this.recipeBatchActive) {
+            this.finalizeRecipeLoading();
+        }
     }
     // CraftBukkit end
 
