-    private Path locateStatsFile(final GameProfile gameProfile) {
+    public Path locateStatsFile(final GameProfile gameProfile) { // BTCCore - stats-sql: private -> public, the login asks for the file before the player exists
         Path statFolder = this.server.getWorldPath(LevelResource.PLAYER_STATS_DIR);
         Path uuidStatsFile = statFolder.resolve(gameProfile.id() + ".json");
         if (Files.exists(uuidStatsFile)) {
diff --git a/net/minecraft/stats/ServerStatsCounter.java b/net/minecraft/stats/ServerStatsCounter.java
index 718a392b6975150b60786cc7bb101541a5832754..6e871058fcd2c104d2e197ea6615acfba5393b8a 100644
--- a/net/minecraft/stats/ServerStatsCounter.java
+++ b/net/minecraft/stats/ServerStatsCounter.java
@@ -88,9 +88,43 @@ public class ServerStatsCounter extends StatsCounter {
         // Paper end - Moved after stat fetching for player state file
     }
 
+    // BTCCore start - stats-sql: the player comes in with what its login loaded from the database
+    private java.util.@org.jspecify.annotations.Nullable UUID sqlPlayer; // set while this counter is a session of the layer
+    private boolean sqlChanged; // a statistic changed since the last save the layer took
+
+    /** Called once, when the player whose login went through the gate is about to be placed in the game. */
+    public void bindSql(final MinecraftServer server, final java.util.UUID player) {
+        dev.btc.core.stats.sql.StatsSqlService.Loaded session = dev.btc.core.stats.sql.StatsSql.claim(player);
+        if (session == null) {
+            return; // layer closed, or no session: this counter stays on its file, as vanilla
+        }
+        this.sqlPlayer = player;
+        if (session.document() == null) {
+            return; // the session starts from the file this counter already read
+        }
+        this.stats.clear(); // the stored document replaces the local file, it is not added to it
+        try {
+            this.parse(server.getFixerUpper(), StrictJsonParser.parse(session.document()));
+        } catch (JsonParseException e) {
+            LOGGER.error("Couldn't parse stored statistics of {}", player, e);
+            this.sqlPlayer = null; // what could not be read is never written over: this counter stays on its file, marked
+        }
+        for (Map.Entry<net.minecraft.resources.Identifier, Integer> entry : org.spigotmc.SpigotConfig.forcedStats.entrySet()) { // as the constructor does after reading the file
+            this.stats.put(Stats.CUSTOM.get(java.util.Objects.requireNonNull(BuiltInRegistries.CUSTOM_STAT.getValue(entry.getKey()))), entry.getValue().intValue());
+        }
+    }
+    // BTCCore end - stats-sql
+
     public void save() {
         if (dev.btc.core.config.BTCCoreConfig.zfStatsEnabled) return; // BTCCore - zero-features.stats
         if (org.spigotmc.SpigotConfig.disableStatSaving) return; // Spigot
+        // BTCCore start - stats-sql: a session of the layer hands its document over; any other counter marks its file before writing it
+        if (this.sqlPlayer != null && dev.btc.core.stats.sql.StatsSql.save(this.sqlPlayer, this.sqlChanged, SharedConstants.getCurrentVersion().dataVersion().version(), () -> this.toJson().toString())) {
+            this.sqlChanged = false;
+            return;
+        }
+        dev.btc.core.stats.sql.StatsSql.writingFile(this.file);
+        // BTCCore end - stats-sql
         try {
             FileUtil.createDirectoriesSafe(this.file.getParent());
 
@@ -109,6 +143,7 @@ public class ServerStatsCounter extends StatsCounter {
         if (stat.getType() == Stats.CUSTOM && stat.getValue() instanceof final net.minecraft.resources.Identifier key && org.spigotmc.SpigotConfig.forcedStats.get(key) != null) return; // Paper - disable saving forced stats
         super.setValue(player, stat, count);
         this.dirty.add(stat);
+        this.sqlChanged = true; // BTCCore - stats-sql: only a changed counter is handed over
     }
 
     private Set<Stat<?>> getDirty() {
