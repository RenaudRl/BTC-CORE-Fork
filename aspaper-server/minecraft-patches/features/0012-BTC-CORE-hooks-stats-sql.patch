diff --git a/net/minecraft/server/network/config/PrepareSpawnTask.java b/net/minecraft/server/network/config/PrepareSpawnTask.java
index 0278bd71c88e39ca038d7410900f9094b187db3a..83804dd4879e71a093d23825444dde3460e581b8 100644
--- a/net/minecraft/server/network/config/PrepareSpawnTask.java
+++ b/net/minecraft/server/network/config/PrepareSpawnTask.java
@@ -41,6 +41,8 @@ public class PrepareSpawnTask implements ConfigurationTask {
     private final net.minecraft.server.network.ServerConfigurationPacketListenerImpl listener;
     private boolean newPlayer;
     private net.minecraft.world.level.storage.PlayerDataStorage.@Nullable LoginRead loginRead; // BTCCore - one .dat read per connection
+    private @Nullable CompletableFuture<dev.btc.core.stats.sql.StatsSqlService.Loaded> statsLoad; // BTCCore - stats-sql: null while the layer is closed
+    private long statsLoadStarted; // BTCCore - stats-sql
 
     public PrepareSpawnTask(final MinecraftServer server, final com.mojang.authlib.GameProfile profile, final net.minecraft.server.network.ServerConfigurationPacketListenerImpl listener) {
         this.profile = profile;
@@ -53,6 +55,10 @@ public class PrepareSpawnTask implements ConfigurationTask {
 
     @Override
     public void start(final Consumer<Packet<?>> connection) {
+        // BTCCore start - stats-sql: the statistics are read off this thread while the spawn is prepared
+        this.statsLoadStarted = System.nanoTime();
+        this.statsLoad = dev.btc.core.stats.sql.StatsSql.preload(this.nameAndId.id(), () -> this.server.getPlayerList().locateStatsFile(this.profile));
+        // BTCCore end - stats-sql
         try (ProblemReporter.ScopedCollector reporter = new ProblemReporter.ScopedCollector(LOGGER)) {
             this.loginRead = this.server.getPlayerList().loadPlayerDataForLogin(this.nameAndId); // BTCCore - one .dat read per connection: kept for the spawn
             Optional<ValueInput> loadedData = this.loginRead.data() // BTCCore - one .dat read per connection
@@ -116,6 +122,7 @@ public class PrepareSpawnTask implements ConfigurationTask {
 
     @Override
     public boolean tick() {
+        if (!dev.btc.core.stats.sql.StatsSql.ready(this.statsLoad, this.statsLoadStarted, this.nameAndId.id())) return false; // BTCCore - stats-sql: the player waits for its statistics, at most load-timeout-ms; never blocks
         return switch (this.state) {
             case null -> false;
             case PrepareSpawnTask.Preparing preparing -> {
@@ -147,6 +154,7 @@ public class PrepareSpawnTask implements ConfigurationTask {
     }
 
     public void close() {
+        dev.btc.core.stats.sql.StatsSql.abandon(this.statsLoad, this.nameAndId.id()); // BTCCore - stats-sql: the connection closed before the player was in the game, its lease is given back
         if (this.state instanceof PrepareSpawnTask.Preparing preparing) {
             preparing.cancel();
         }
@@ -281,6 +289,7 @@ public class PrepareSpawnTask implements ConfigurationTask {
             }
             // Paper end - configuration api - possibly use legacy saved server player instance
             PrepareSpawnTask.this.listener.paperConnection.applyPendingEntityId(player); // Paper - internal entity id api - possibly override player network id if plugins used internal API to configure it.
+            player.getStats().bindSql(PrepareSpawnTask.this.server, PrepareSpawnTask.this.nameAndId.id()); // BTCCore - stats-sql: here and not in the counter's constructor, a player made for a legacy login event exists before the statistics were asked for
 
             try (ProblemReporter.ScopedCollector reporter = new ProblemReporter.ScopedCollector(player.problemPath(), PrepareSpawnTask.LOGGER)) {
                 // BTCCore start - one .dat read per connection: the tag read at start() is the file's content while the file has not changed
