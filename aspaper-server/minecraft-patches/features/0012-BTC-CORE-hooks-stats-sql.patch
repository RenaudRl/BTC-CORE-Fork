         // Spigot start
         this.setPlayerList(new DedicatedPlayerList(this, this.registries(), this.playerDataStorage));
+        dev.btc.core.stats.sql.StatsSql.start(dev.btc.core.config.BTCCoreConfig.statsSql, id -> this.getPlayerList().getPlayer(id) != null, this.getWorldPath(net.minecraft.world.level.storage.LevelResource.PLAYER_STATS_DIR)); // BTCCore - stats-sql: no-op unless stats-sql.enabled
         org.spigotmc.SpigotConfig.init((java.io.File) this.options.valueOf("spigot-settings"));
         org.spigotmc.SpigotConfig.registerCommands();
