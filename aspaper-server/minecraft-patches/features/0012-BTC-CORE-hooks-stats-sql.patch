diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index 25c196cf89e60cf49bf16db35af6076693bbf3bb..8774207af46f4f90ded3b7c0477677a907b2f682 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -1019,6 +1019,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
             this.playerList.removeAll(this.isRestarting); // Paper
             this.getConnection().handleAllDisconnections(); // Paper
         }
+        dev.btc.core.stats.sql.StatsSql.stop(); // BTCCore - stats-sql: queued statistics are stored and the leases given back, or kept in their files past the timeout
         dev.btc.core.playerdata.PlayerDataIo.shared().shutdown(30, java.util.concurrent.TimeUnit.SECONDS); // BTCCore - async.player-data-save, qol.player-data-backup: queued player saves and copies land before the level is closed
 
         LOGGER.info("Saving worlds");
diff --git a/net/minecraft/server/dedicated/DedicatedServer.java b/net/minecraft/server/dedicated/DedicatedServer.java
