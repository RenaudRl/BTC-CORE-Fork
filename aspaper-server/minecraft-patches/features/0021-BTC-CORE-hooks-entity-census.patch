     public final dev.btc.core.performance.@Nullable OpacityIndex btc$opacity = dev.btc.core.config.BTCCoreConfig.raytraceCullingEnabled ? new dev.btc.core.performance.OpacityIndex() : null; // BTCCore - performance.raytrace-culling: the opaque blocks of this world for the culling threads, null with the option off
+    public final dev.btc.core.world.@Nullable EntityCensus btc$census = dev.btc.core.config.BTCCoreConfig.worldEntityCensusEnabled ? new dev.btc.core.world.EntityCensus(net.minecraft.world.entity.MobCategory.values().length, net.minecraft.core.registries.BuiltInRegistries.ENTITY_TYPE.size()) : null; // BTCCore - world.entity-census: the entities of this world by category and by type, null with the option off
     private final ServerWaypointManager waypointManager;
     private EnvironmentAttributeSystem environmentAttributes;
     // Paper - rewrite chunk system
@@ -1721,6 +1722,16 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
                 return true;
             }
             // Paper end - capture all item additions to the world
+            if (this.btc$census != null && spawnReason != null && this.btc$census.refuses(entity.getType().getCategory().ordinal(), spawnReason)) { // BTCCore - world.entity-census: the category has reached the cap a plugin set - refused before the event, with the cleanup a cancelled event gets (CraftEventFactory#doEntityAddEventCalling) for what was made for this spawn, so no mount is left without its rider, no rider without its mount, no raider enrolled and never added; no reason is a journey between worlds, never refused
+                final Entity btc$vehicle = entity.getVehicle();
+                if (btc$vehicle != null) {
+                    if (dev.btc.core.world.EntityCensus.madeForSpawn(btc$vehicle.valid, btc$vehicle.totalEntityAge)) btc$vehicle.discard(null);
+                    else if (btc$vehicle instanceof net.minecraft.world.entity.animal.chicken.Chicken btc$chicken) btc$chicken.setChickenJockey(false); // BTCCore - world.entity-census: a mount that lived in the world before this spawn stays in it - the chicken a baby zombie climbed on (Zombie#finalizeSpawn) is given back, not left to despawn as a jockey's
+                }
+                for (final Entity btc$passenger : entity.getIndirectPassengers()) btc$passenger.discard(null);
+                entity.discard(null);
+                return false;
+            }
             // SPIGOT-6415: Don't call spawn event when reason is null. For example when an entity teleports to a new world.
             if (spawnReason != null && !org.bukkit.craftbukkit.event.CraftEventFactory.doEntityAddEventCalling(this, entity, spawnReason)) {
                 return false;
@@ -3177,6 +3188,7 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
         @Override
         public void onTrackingStart(final Entity entity) {
             org.spigotmc.AsyncCatcher.catchOp("entity register"); // Spigot
+            if (ServerLevel.this.btc$census != null) ServerLevel.this.btc$census.added(entity.getType().getCategory().ordinal(), net.minecraft.core.registries.BuiltInRegistries.ENTITY_TYPE.getId(entity.getType())); // BTCCore - world.entity-census
             // ServerLevel.this.getChunkSource().addEntity(entity); // Paper - ignore and warn about illegal addEntity calls instead of crashing server; moved down below valid=true
             if (entity instanceof ServerPlayer player) {
                 ServerLevel.this.players.add(player);
@@ -3227,6 +3239,7 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
         @Override
         public void onTrackingEnd(final Entity entity) {
             org.spigotmc.AsyncCatcher.catchOp("entity unregister"); // Spigot
+            if (ServerLevel.this.btc$census != null) ServerLevel.this.btc$census.removed(entity.getType().getCategory().ordinal(), net.minecraft.core.registries.BuiltInRegistries.ENTITY_TYPE.getId(entity.getType())); // BTCCore - world.entity-census
             // Spigot start
             if (entity instanceof Player player) {
                 SavedDataStorage storage = getServer().getDataStorage();
