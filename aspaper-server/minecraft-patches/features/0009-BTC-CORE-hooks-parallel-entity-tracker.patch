-                // Paper end - Configurable entity tracking range by Y
-                // CraftBukkit start - respect vanish API
-                if (visibleToPlayer && !player.getBukkitEntity().canSee(this.entity.getBukkitEntity())) { // Paper - only consider hits
-                    visibleToPlayer = false;
-                }
-                // CraftBukkit end
+                final boolean visibleToPlayer = this.btc$visibleTo(player); // BTCCore - async.parallel-tracker - the test moved below, unchanged, so the read-only scan shares it
                 if (visibleToPlayer) {
                     if (this.seenBy.add(player.connection)) {
                         // Paper start - entity tracking events
@@ -1455,6 +1477,57 @@ public class ChunkMap extends SimpleRegionStorage implements ChunkHolder.PlayerP
             }
         }
 
+        // BTCCore start - async.parallel-tracker
+        // The visibility test of updatePlayer, verbatim. It reads and never writes, which is what
+        // lets the scan below call it from a pool thread while the owning thread waits.
+        private boolean btc$visibleTo(final ServerPlayer player) {
+            // Paper start - remove allocation of Vec3 here
+            // Vec3 deltaToPlayer = player.position().subtract(this.entity.position());
+            double deltaToPlayerX = player.getX() - this.entity.getX();
+            double deltaToPlayerZ = player.getZ() - this.entity.getZ();
+            // Paper end - remove allocation of Vec3 here
+            int playerViewDistance = ChunkMap.this.getPlayerViewDistance(player);
+            double visibleRange = Math.min(this.getEffectiveRange(), playerViewDistance * 16);
+            double distanceSquared = deltaToPlayerX * deltaToPlayerX + deltaToPlayerZ * deltaToPlayerZ; // Paper
+            double rangeSquared = visibleRange * visibleRange;
+            // Paper start - Configurable entity tracking range by Y
+            boolean visibleToPlayer = distanceSquared <= rangeSquared;
+            if (visibleToPlayer && level.paperConfig().entities.trackingRangeY.enabled) {
+                double rangeY = level.paperConfig().entities.trackingRangeY.get(this.entity, -1);
+                if (rangeY != -1) {
+                    double deltaToPlayerY = player.getY() - this.entity.getY();
+                    visibleToPlayer = deltaToPlayerY * deltaToPlayerY <= rangeY * rangeY;
+                }
+            }
+            visibleToPlayer = visibleToPlayer
+                && this.entity.broadcastToPlayer(player)
+                && ChunkMap.this.isChunkTracked(player, this.entity.chunkPosition().x(), this.entity.chunkPosition().z());
+            // Paper end - Configurable entity tracking range by Y
+            // CraftBukkit start - respect vanish API
+            if (visibleToPlayer && !player.getBukkitEntity().canSee(this.entity.getBukkitEntity())) { // Paper - only consider hits
+                visibleToPlayer = false;
+            }
+            // CraftBukkit end
+            return visibleToPlayer;
+        }
+
+        // Read-only twin of moonrise$tick: false only when that method would change nothing.
+        final boolean btc$needsTick(final ca.spottedleaf.moonrise.common.misc.NearbyPlayers.TrackedChunk chunk) {
+            final ca.spottedleaf.moonrise.common.list.ReferenceList<ServerPlayer> players =
+                chunk == null ? null : chunk.getPlayers(ca.spottedleaf.moonrise.common.misc.NearbyPlayers.NearbyMapType.VIEW_DISTANCE);
+            if (players == null) {
+                // moonrise$clearPlayers: something to reset or someone to remove
+                return this.lastChunkUpdate != -1L || this.lastTrackedChunk != null || !this.seenBy.isEmpty();
+            }
+            if (this.lastChunkUpdate != chunk.getUpdateCount() || this.lastTrackedChunk != chunk) {
+                return true; // the chunk's player list moved: Paper's purge has to run
+            }
+            return dev.btc.core.async.ParallelTracker.visibilityChanged(
+                players.getRawDataUnchecked(), players.size(), this.entity,
+                this::btc$visibleTo, player -> this.seenBy.contains(player.connection));
+        }
+        // BTCCore end - async.parallel-tracker
+
         private int scaledRange(final int range) {
             return ChunkMap.this.level.getServer().getScaledTrackingDistance(range);
         }
