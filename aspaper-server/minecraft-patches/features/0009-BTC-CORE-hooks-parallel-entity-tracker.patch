index fd0b9f20fbdd523d51550fd6009b5011e6e7e6e6..5bc85ee77b0168e7981366126433bcb1c8846a9d 100644
--- a/net/minecraft/server/level/ChunkMap.java
+++ b/net/minecraft/server/level/ChunkMap.java
@@ -1116,7 +1116,55 @@ public class ChunkMap extends SimpleRegionStorage implements ChunkHolder.PlayerP
     }
     // Paper end - optimise entity tracker
 
+    // BTCCore start - async.parallel-tracker
+    // newTrackerTick with the read-only half done first, in parallel: the pool only answers "would
+    // moonrise$tick change anything for this entity?", the caller waits for every batch, and what
+    // follows is Paper's own loop on the owning thread, minus the ticks known to be no-ops.
+    private void btc$parallelTrackerTick() {
+        this.iteratingTrackerEntities = true;
+        try {
+            final ca.spottedleaf.moonrise.common.list.ReferenceList<net.minecraft.world.entity.Entity> trackerEntities = this.trackerEntities;
+            final Entity[] trackerEntitiesRaw = trackerEntities.getRawDataUnchecked();
+            final int len = trackerEntities.size();
+            final boolean[] needsTick = new boolean[len]; // one slot per entity, written by one batch only
+            dev.btc.core.async.ParallelTracker.runBatches(len, (from, to) -> {
+                for (int i = from; i < to; ++i) {
+                    final Entity entity = trackerEntitiesRaw[i];
+                    final ChunkMap.TrackedEntity tracker = ((ca.spottedleaf.moonrise.patches.entity_tracker.EntityTrackerEntity)entity).moonrise$getTrackedEntity();
+                    needsTick[i] = tracker != null && tracker.btc$needsTick(((ca.spottedleaf.moonrise.patches.chunk_system.entity.ChunkSystemEntity)entity).moonrise$getChunkData().nearbyPlayers);
+                }
+            });
+            // Barrier passed: no worker is reading any more. A listener called below can still move
+            // a player the scan already cleared; that entity is then picked up by the next tick.
+            for (int i = 0; i < len; ++i) {
+                final Entity entity = trackerEntitiesRaw[i];
+                final ChunkMap.TrackedEntity tracker = ((ca.spottedleaf.moonrise.patches.entity_tracker.EntityTrackerEntity)entity).moonrise$getTrackedEntity();
+                if (tracker == null) {
+                    continue;
+                }
+                if (needsTick[i]) {
+                    ((ca.spottedleaf.moonrise.patches.entity_tracker.EntityTrackerTrackedEntity)tracker).moonrise$tick(((ca.spottedleaf.moonrise.patches.chunk_system.entity.ChunkSystemEntity)entity).moonrise$getChunkData().nearbyPlayers);
+                }
+                // null-safe where Paper is not: the status of an entity still being added (DivineMC #70)
+                final FullChunkStatus chunkStatus = ((ca.spottedleaf.moonrise.patches.chunk_system.entity.ChunkSystemEntity)entity).moonrise$getChunkStatus();
+                if (((ca.spottedleaf.moonrise.patches.entity_tracker.EntityTrackerTrackedEntity)tracker).moonrise$hasPlayers()
+                    || (chunkStatus != null && chunkStatus.isOrAfter(FullChunkStatus.ENTITY_TICKING))) {
+                    tracker.serverEntity.sendChanges();
+                }
+            }
+        } finally {
+            this.iteratingTrackerEntities = false;
+        }
+    }
+    // BTCCore end - async.parallel-tracker
+
     protected void tick() {
+        // BTCCore start - async.parallel-tracker
+        if (dev.btc.core.config.BTCCoreConfig.parallelTrackerEnabled) {
+            this.btc$parallelTrackerTick();
+            return;
+        }
+        // BTCCore end - async.parallel-tracker
         // Paper start - optimise entity tracker
         if (true) {
             this.newTrackerTick();
@@ -1408,33 +1456,7 @@ public class ChunkMap extends SimpleRegionStorage implements ChunkHolder.PlayerP
         public void updatePlayer(final ServerPlayer player) {
             org.spigotmc.AsyncCatcher.catchOp("player tracker update"); // Spigot
             if (player != this.entity) {
