Date: Fri, 14 Aug 2026 15:49:01 +0200
Subject: [PATCH] BTC-CORE hooks


diff --git a/src/main/java/org/bukkit/craftbukkit/CraftServer.java b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
index c89976f34bf73b65b0ca297b00a0f71cde3c5d80..99a7685748b15677b103f330b95c2146c130645a 100644
--- a/src/main/java/org/bukkit/craftbukkit/CraftServer.java
+++ b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
@@ -764,6 +764,7 @@ public final class CraftServer implements Server {
 
     @Override
     public boolean getAllowEnd() {
+        if (dev.btc.core.config.BTCCoreConfig.overworldOnly) return false; // BTCCore - world.overworld-only
         return this.configuration.getBoolean("settings.allow-end");
     }
 
@@ -1149,6 +1150,14 @@ public final class CraftServer implements Server {
         //Preconditions.checkState(!this.console.isIteratingOverLevels, "Cannot create a world while worlds are being ticked"); // Paper - Cat - Temp disable. We'll see how this goes.
         Preconditions.checkArgument(creator != null, "WorldCreator cannot be null");
 
+        // BTCCore start - world.overworld-only: refuse any nether/end world, whoever asks for it
+        if (dev.btc.core.config.BTCCoreConfig.isDimensionBlocked(creator.environment().name())) {
+            this.getLogger().warning("[BTCCore] Refused to create world '" + creator.name() + "' ("
+                    + creator.environment() + "): world.overworld-only is enabled in btccore.yml");
+            return null;
+        }
+        // BTCCore end
+
         String name = creator.name();
         ChunkGenerator chunkGenerator = creator.generator();
         BiomeProvider biomeProvider = creator.biomeProvider();
@@ -1335,6 +1344,12 @@ public final class CraftServer implements Server {
 
             handle.getChunkSource().close(save);
             io.papermc.paper.FeatureHooks.closeEntityManager(handle, save); // SPIGOT-6722: close entityManager // Paper - chunk system
+        // BTCCore start - a close that throws is logged and the world leaves the server all the same: what follows must still run, it gives the lease of a Slime world back
+        } catch (Exception ex) {
+            this.getLogger().log(Level.SEVERE, null, ex);
+        }
+        try {
+        // BTCCore end
 
             //ASP start - avoid temp storage leak during runtime
             if(handle instanceof com.infernalsuite.asp.level.SlimeLevelInstance asp) {
