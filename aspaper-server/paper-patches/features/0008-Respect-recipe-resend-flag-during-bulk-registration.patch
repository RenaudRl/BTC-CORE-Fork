From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: BTC Core <core@borntocraftstudio.net>
Date: Mon, 17 Aug 2026 05:15:00 +0200
Subject: [PATCH] Respect recipe resend flag during bulk registration

The Bukkit API exposes resendRecipes=false specifically for bulk updates. The
fork had this flag disabled unconditionally, causing every RPG Core recipe to
reload the complete client recipe book and trip the watchdog. The recipe
manager batch boundary keeps NMS display indexes consistent and finalizes once.

diff --git a/src/main/java/org/bukkit/craftbukkit/CraftServer.java b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
index 2cdfe39ce0c126f757dbbb94bdb69239b565024b..97c5b1e8ce68435013eece499990437015c11668 100644
--- a/src/main/java/org/bukkit/craftbukkit/CraftServer.java
+++ b/src/main/java/org/bukkit/craftbukkit/CraftServer.java
@@ -1077,6 +1077,7 @@ public final class CraftServer implements Server {
 
     @Override
     public void updateRecipes() {
+        this.getServer().getRecipeManager().endRecipeBatch();
         this.playerList.reloadRecipes();
     }
     // Paper end - API for updating recipes on clients
@@ -1450,6 +1451,29 @@ public final class CraftServer implements Server {
         return true;
     }
 
+    // BTCCore start - batch recipe finalization
+    // Paper 26.3 made the resendRecipes overloads ignore their flag; RPGCore registers ~1,500
+    // recipes with resendRecipes=false then calls updateRecipes() once, so the flag must keep
+    // deferring finalization or every recipe pays a full finalize + resource reload.
+    @Override
+    public boolean addRecipe(Recipe recipe, boolean resendRecipes) {
+        final CraftRecipe craftRecipe = CraftRecipe.fromBukkitRecipe(recipe);
+        if (craftRecipe == null) {
+            return false;
+        }
+
+        final RecipeManager recipeManager = this.getServer().getRecipeManager();
+        if (!resendRecipes) {
+            recipeManager.beginRecipeBatch();
+        }
+        craftRecipe.addToRecipeManager();
+        if (resendRecipes) {
+            recipeManager.endRecipeBatch();
+        }
+        return true;
+    }
+    // BTCCore end
+
     @Override
     public boolean addRecipes(Iterable<Recipe> recipes) {
         org.spigotmc.AsyncCatcher.catchOp("Recipes Add");
@@ -1669,6 +1693,23 @@ public final class CraftServer implements Server {
         return anyRemoved;
     }
 
+    // BTCCore start - batch recipe finalization (see addRecipe(Recipe, boolean))
+    @Override
+    public boolean removeRecipe(NamespacedKey recipeKey, boolean resendRecipes) {
+        Preconditions.checkArgument(recipeKey != null, "recipeKey cannot be null");
+        final RecipeManager recipeManager = this.getServer().getRecipeManager();
+        if (!resendRecipes) {
+            recipeManager.beginRecipeBatch();
+        }
+        final ResourceKey<net.minecraft.world.item.crafting.Recipe<?>> id = CraftNamespacedKey.toResourceKey(Registries.RECIPE, recipeKey);
+        final boolean removed = recipeManager.removeRecipe(id);
+        if (removed && resendRecipes) {
+            recipeManager.endRecipeBatch();
+        }
+        return removed;
+    }
+    // BTCCore end
+
     @Override
     public Map<String, String[]> getCommandAliases() {
         ConfigurationSection section = this.commandsConfiguration.getConfigurationSection("aliases");
