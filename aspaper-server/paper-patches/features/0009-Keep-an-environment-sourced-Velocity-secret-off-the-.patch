From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: renaud <rlpirou@gmail.com>
Date: Tue, 15 Sep 2026 08:44:41 +0200
Subject: [PATCH] Keep an environment-sourced Velocity secret off the disk

Upstream reads PAPER_VELOCITY_SECRET in a @PostProcess hook and copies it
into the `secret` field, which Configurate then writes back into
paper-global.yml. Measured on the CloudNet bench on 2026-09-15: a template
shipping `secret: ""` produced a service whose file carried the 32-character
secret after the first start.

The secret that is actually used now lives in a transient field, which
Configurate never serialises. The file keeps whatever the file said.

diff --git a/src/main/java/com/destroystokyo/paper/proxy/VelocityProxy.java b/src/main/java/com/destroystokyo/paper/proxy/VelocityProxy.java
index fcd94bb0b7d2c00fb225835950ff76818dfd0cca..cb71ed374d922ddf337b14a305765220a2011bb0 100644
--- a/src/main/java/com/destroystokyo/paper/proxy/VelocityProxy.java
+++ b/src/main/java/com/destroystokyo/paper/proxy/VelocityProxy.java
@@ -46,7 +46,7 @@ public class VelocityProxy {
 
         try {
             final Mac mac = Mac.getInstance("HmacSHA256");
-            mac.init(new SecretKeySpec(GlobalConfiguration.get().proxies.velocity.secret.getBytes(java.nio.charset.StandardCharsets.UTF_8), "HmacSHA256"));
+            mac.init(new SecretKeySpec(GlobalConfiguration.get().proxies.velocity.effectiveSecret().getBytes(java.nio.charset.StandardCharsets.UTF_8), "HmacSHA256")); // BTC-CORE - keep an environment-sourced secret off the disk
             final byte[] mySignature = mac.doFinal(data);
             if (!MessageDigest.isEqual(signature, mySignature)) {
                 return false;
diff --git a/src/main/java/io/papermc/paper/configuration/GlobalConfiguration.java b/src/main/java/io/papermc/paper/configuration/GlobalConfiguration.java
index 232bc5e8b7cbb528b96f8048ba683705cddc436e..85ef82506037dd41125346eb90b414ac386ca105 100644
--- a/src/main/java/io/papermc/paper/configuration/GlobalConfiguration.java
+++ b/src/main/java/io/papermc/paper/configuration/GlobalConfiguration.java
@@ -119,17 +119,32 @@ public class GlobalConfiguration extends ConfigurationPart {
             public boolean enabled = false;
             public boolean onlineMode = true;
             public String secret = "";
+            // BTC-CORE start - keep an environment-sourced secret off the disk
+            // The secret actually used to verify forwarded connections: PAPER_VELOCITY_SECRET when it is set,
+            // the file's value otherwise. It is `transient` on purpose: Configurate skips transient fields when
+            // it writes paper-global.yml back, so a secret that came from the environment never reaches the
+            // disk. Upstream copied the environment value into `secret` itself, which was then serialised into
+            // the file - on an orchestrated service recreated from a template, that put the secret into every
+            // service directory, and into every backup of it.
+            private transient String effectiveSecret = "";
+
+            public String effectiveSecret() {
+                return this.effectiveSecret;
+            }
+            // BTC-CORE end - keep an environment-sourced secret off the disk
 
             @PostProcess
             private void postProcess() {
                 if (!this.enabled) return;
 
+                // BTC-CORE start - keep an environment-sourced secret off the disk
                 final String environmentSourcedVelocitySecret = System.getenv("PAPER_VELOCITY_SECRET");
-                if (environmentSourcedVelocitySecret != null && !environmentSourcedVelocitySecret.isEmpty()) {
-                    this.secret = environmentSourcedVelocitySecret;
-                }
+                this.effectiveSecret = environmentSourcedVelocitySecret != null && !environmentSourcedVelocitySecret.isEmpty()
+                    ? environmentSourcedVelocitySecret
+                    : this.secret;
 
-                if (this.secret.isEmpty()) {
+                if (this.effectiveSecret.isEmpty()) {
+                // BTC-CORE end - keep an environment-sourced secret off the disk
                     LOGGER.error("Velocity is enabled, but no secret key was specified. A secret key is required. Disabling velocity...");
                     this.enabled = false;
                 }
